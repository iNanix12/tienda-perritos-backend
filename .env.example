# Copiar este archivo como .env y completar con los valores reales.
# .env NUNCA debe subirse a git (ya está en .gitignore).

PORT=3001
DB_HOST=<IP_PRIVADA_DE_LA_INSTANCIA_DB>
DB_USER=root
DB_PASSWORD=<CONTRASEÑA_SEGURA>
DB_NAME=tienda_perritos
DB_PORT=3306

# IP pública (o dominio) del frontend, para restringir CORS
CORS_ORIGIN=http://<IP_PUBLICA_FRONTEND>
